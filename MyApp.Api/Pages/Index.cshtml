@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="hero-section">

    <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        BUP CSE FEST 2026 &nbsp;·&nbsp; LLM Energy Optimization Challenge
    </div>

    <h1 class="hero-title">
        Smart Campus Microgrid<br/>Optimization with AI
    </h1>

    <p class="hero-subtitle">
        LLM-powered directive interpreter paired with OR-Tools CBC solver for
        precise 24-hour dispatch planning, solar harvesting, and battery arbitrage.
    </p>

    <div class="hero-actions">
        <a asp-page="/Optimize" id="btn-launch-optimizer" class="btn btn-primary btn-lg">
            ⚡&nbsp; Launch Optimizer
        </a>
        <a asp-page="/History" id="btn-view-history" class="btn btn-secondary btn-lg">
            📋&nbsp; Run History
        </a>
        <a href="/swagger" target="_blank" id="btn-api-docs" class="btn btn-outline btn-lg">
            🔗&nbsp; API Reference
        </a>
    </div>

    <div class="features-grid stagger">
        <div class="feature-card animate-in">
            <div class="feature-icon">🤖</div>
            <h3>LLM Directive Interpreter</h3>
            <p>Gemini AI translates operator notes into precise mathematical constraints — solar reductions, charge windows, and grid caps.</p>
        </div>
        <div class="feature-card animate-in">
            <div class="feature-icon">🔋</div>
            <h3>Battery &amp; Tariff Arbitrage</h3>
            <p>CBC Mixed-Integer solver charges during low-tariff solar windows and discharges during peak price hours to minimise grid cost.</p>
        </div>
        <div class="feature-card animate-in">
            <div class="feature-icon">✅</div>
            <h3>Deterministic Validator</h3>
            <p>Independent hour-by-hour replay guarantees energy balance, SoC limits, ramp rates, and end-of-day neutrality across all 12 rules.</p>
        </div>
        <div class="feature-card animate-in">
            <div class="feature-icon">☀️</div>
            <h3>Solar Harvest Optimization</h3>
            <p>Maximises on-site solar utilisation while respecting operator-mandated reduction windows and forecasted irradiance profiles.</p>
        </div>
        <div class="feature-card animate-in">
            <div class="feature-icon">📊</div>
            <h3>Full Run History</h3>
            <p>Every run is persisted to Supabase PostgreSQL with scenario parameters, directive interpretations, and full hourly dispatch plans.</p>
        </div>
        <div class="feature-card animate-in">
            <div class="feature-icon">💬</div>
            <h3>AI Chat Assistant</h3>
            <p>Conversational interface to query energy data, explain dispatch decisions, and explore optimization strategies in plain language.</p>
        </div>
    </div>

    <div style="margin-top:4rem;">
        <div class="section-label">Technical Specification</div>
        <div class="stats-grid stagger" style="margin-top:0.5rem;">
            <div class="stat-card animate-in">
                <div class="stat-value">24h</div>
                <div class="stat-label">Horizon</div>
            </div>
            <div class="stat-card animate-in">
                <div class="stat-value">MIP</div>
                <div class="stat-label">Model Type</div>
            </div>
            <div class="stat-card animate-in">
                <div class="stat-value">CBC</div>
                <div class="stat-label">OR-Tools Solver</div>
            </div>
            <div class="stat-card animate-in">
                <div class="stat-value" style="font-size:1.2rem;">Gemini</div>
                <div class="stat-label">LLM Backend</div>
            </div>
            <div class="stat-card animate-in">
                <div class="stat-value">12</div>
                <div class="stat-label">Validation Rules</div>
            </div>
            <div class="stat-card animate-in">
                <div class="stat-value" style="font-size:1.2rem;">1e-4</div>
                <div class="stat-label">SoC Tolerance</div>
            </div>
        </div>
    </div>
</div>

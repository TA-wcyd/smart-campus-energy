@page
@model HistoryModel
@{
    ViewData["Title"] = "Optimization History";
}

<div class="page-container">
    <div class="page-header animate-in">
        <div class="page-title">📋 Optimization History</div>
        <div class="page-subtitle">Past 24-hour optimization runs, scenario inputs, and executed dispatch schedules.</div>
    </div>

    <div class="card animate-in">
        @if (Model.Scenarios == null || Model.Scenarios.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📁</div>
                <div class="empty-title">No Scenarios Recorded</div>
                <div class="empty-text">You haven't run any optimizations yet. Submit a scenario to get started.</div>
                <a asp-page="/Optimize" class="btn btn-primary">⚡ Go to Optimizer</a>
            </div>
        }
        else
        {
            <div class="card-header">
                <span class="card-title">📋 Recent Runs</span>
                <span class="badge badge-success">@Model.Scenarios.Count scenarios</span>
            </div>

            <div class="history-list stagger">
                @foreach (var item in Model.Scenarios)
                {
                    <a class="history-item animate-in"
                       asp-page="/HistoryDetail" asp-route-id="@item.Id"
                       id="history-@item.Id">
                        <div>
                            <div class="history-item-id">@item.ScenarioId</div>
                            <div class="history-item-meta">
                                @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                                &nbsp;·&nbsp;
                                <span style="font-family:var(--font-mono);font-size:0.75rem;opacity:0.6;">@item.Id.ToString()[..8]…</span>
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:0.75rem;">
                            <span class="badge badge-success">Completed</span>
                            <span style="color:var(--text-muted);font-size:1.1rem;">→</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
